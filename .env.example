# Copy to .env and fill in one key. claudius also falls back to ../claudette/.env
# automatically, so if you already configured claudette you may not need this.

# Easiest: one OpenRouter key reaches every provider.
OPENROUTER_API_KEY=

# Or point the config's base_url/api_key_env at another OpenAI-compatible host:
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
# GROQ_API_KEY=
